<UserControl x:Class="Takt.Prikaz.EkranPodesavanja"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prikaz="clr-namespace:Takt.Prikaz"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="NaTockic">
        <Grid Margin="6,0,6,6" MaxWidth="760" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="2,4,0,14">
                <TextBlock Style="{StaticResource NaslovStrane}" Text="Podešavanja" />
                <TextBlock Style="{StaticResource OpisStrane}" Margin="0,3,0,0"
                           Text="Program ništa ne šalje na internet. Sve što izmeri ostaje u folderu podataka na ovom računaru." />
            </StackPanel>

            <!-- Left: what the user chooses -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Kartica}" VerticalAlignment="Top">
                <StackPanel Margin="20,18,20,18">
                    <TextBlock Style="{StaticResource NaslovSekcije}" Text="OSVEŽAVANJE" />
                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                        <ListBox Style="{StaticResource Pilule}"
                                 ItemsSource="{Binding OpcijeOsvezavanja}"
                                 SelectedItem="{Binding Osvezavanje}" />
                        <TextBlock Text="sekundi između dva čitanja" Foreground="{StaticResource Mutan}"
                                   FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Važi odmah. Ređe čitanje znači i manje posla za procesor."
                               Foreground="{StaticResource Bled}" FontSize="11" Margin="0,7,0,0" />

                    <Border Height="1" Background="{StaticResource Linija}" Margin="0,18,0,16" />

                    <TextBlock Style="{StaticResource NaslovSekcije}" Text="{prikaz:T 'JEZIK'}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <RadioButton Content="{prikaz:T 'Srpski'}" IsChecked="{Binding Srpski}" GroupName="Jezik"
                                     VerticalAlignment="Center" />
                        <RadioButton Content="{prikaz:T 'Engleski'}" IsChecked="{Binding Engleski}" GroupName="Jezik"
                                     Margin="18,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{prikaz:T 'Jezik važi posle ponovnog pokretanja programa.'}"
                               Foreground="{StaticResource Bled}" FontSize="11" Margin="0,7,0,0" />

                    <Border Height="1" Background="{StaticResource Linija}" Margin="0,18,0,16" />

                    <TextBlock Style="{StaticResource NaslovSekcije}" Text="{prikaz:T 'ISTORIJA'}" />
                    <CheckBox Content="{prikaz:T 'Čuvaj istoriju u bazi (jedan red u minuti)'}" IsChecked="{Binding Istorija}"
                              Margin="0,10,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                        <ListBox Style="{StaticResource Pilule}"
                                 ItemsSource="{Binding OpcijeDana}"
                                 SelectedItem="{Binding IstorijaDana}" />
                        <TextBlock Text="{prikaz:T 'dana se čuva, starije se briše'}" Foreground="{StaticResource Mutan}"
                                   FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource Linija}" Margin="0,18,0,16" />

                    <TextBlock Style="{StaticResource NaslovSekcije}" Text="{prikaz:T 'PODACI'}" />
                    <CheckBox Content="{prikaz:T 'Probni podaci (izmišljena merenja, za pregled i slike ekrana)'}"
                              IsChecked="{Binding ProbniPodaci}" Margin="0,10,0,0" />
                    <TextBlock Text="{prikaz:T 'Istorija i probni podaci važe posle ponovnog pokretanja programa.'}"
                               Foreground="{StaticResource Bled}" FontSize="11" Margin="0,7,0,0" />

                    <Border Height="1" Background="{StaticResource Linija}" Margin="0,18,0,16" />

                    <TextBlock Style="{StaticResource NaslovSekcije}" Text="PROZOR I TRAKA" />
                    <CheckBox Content="Zatvori u traku umesto gašenja (X)" IsChecked="{Binding ZatvoriUTraku}"
                              Margin="0,9,0,0" />
                    <CheckBox Content="Pokreni sa Windowsom, u traci (bez prozora)" IsChecked="{Binding PokreniSaWindowsom}"
                              Margin="0,8,0,0" />
                    <TextBlock Text="Ikonica pored sata vraća prozor; bez nje se sakriveni prozor ne može vratiti. Ako traka ne uspe, X gasi program."
                               Foreground="{StaticResource Bled}" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />

                    <Border Height="1" Background="{StaticResource Linija}" Margin="0,18,0,16" />

                    <TextBlock Style="{StaticResource NaslovSekcije}" Text="DRAJVER (PAWNIO)" />
                    <DockPanel Margin="0,9,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DugmeTamno}" Content="Otvori pawnio.eu"
                                Click="NaDrajver" Padding="10,3" VerticalAlignment="Center"
                                Visibility="{Binding DrajverFali, Converter={StaticResource BoolUVidljivost}}" />
                        <TextBlock Text="{Binding DrajverStanje}" FontSize="12.5" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Dobro}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DrajverFali}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Upozorenje}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding DrajverOpis}" Foreground="{StaticResource Bled}" FontSize="11"
                               TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0" />

                    <WrapPanel Margin="0,18,0,0">
                        <Button Style="{StaticResource Dugme}" Content="Sačuvaj" Click="NaSacuvaj" Margin="0,0,8,0" />
                        <Button Style="{StaticResource DugmeTamno}" Content="Otvori folder" Click="NaFolder"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource DugmeTamno}" Content="{Binding TekstBrisanja}" Click="NaObrisi" />
                    </WrapPanel>

                    <TextBlock Text="{Binding Poruka}" Foreground="{StaticResource Akcenat}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Right: about the program and what changed -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Kartica}" VerticalAlignment="Top" Margin="0,12,0,0">
                <StackPanel Margin="20,18,20,18">
                    <TextBlock Style="{StaticResource NaslovSekcije}" Text="O PROGRAMU" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Verzija" Foreground="{StaticResource Bled}" FontSize="11.5"
                                   Margin="0,0,0,6" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Verzija}" Foreground="{StaticResource Tekst}"
                                   FontSize="11.5" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Text="Prava" Foreground="{StaticResource Bled}" FontSize="11.5"
                                   Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Prava}" Foreground="{StaticResource Tekst}"
                                   FontSize="11.5" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="2" Text="Podaci" Foreground="{StaticResource Bled}" FontSize="11.5" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Folder}" Foreground="{StaticResource Mutan}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource Linija}" Margin="0,16,0,14" />

                    <TextBlock Style="{StaticResource NaslovSekcije}" Text="ŠTA JE NOVO" />
                    <ItemsControl ItemsSource="{Binding Istorijat}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}"
                                                BorderThickness="1" CornerRadius="999" Padding="8,1,8,2">
                                            <TextBlock Text="{Binding Oznaka}" Foreground="{StaticResource Akcenat}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="{Binding Datum}" Foreground="{StaticResource Bled}" FontSize="11"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Nove}" Margin="2,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="+" Foreground="{StaticResource Akcenat}" FontSize="11.5" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Mutan}" FontSize="11.5" LineHeight="17" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Dorade}" Margin="2,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="·" Foreground="{StaticResource Bled}" FontSize="13"
                                                               Margin="2,-2,0,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Mutan}" FontSize="11.5" LineHeight="17" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
