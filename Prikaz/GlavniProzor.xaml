<Window x:Class="Takt.Prikaz.GlavniProzor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prikaz="clr-namespace:Takt.Prikaz"
        xmlns:vm="clr-namespace:Takt.Vm"
        Title="BronxSoft Takt"
        Height="800" Width="1240" MinHeight="640" MinWidth="1000"
        Background="{StaticResource Pozadina}"
        FontFamily="{StaticResource Pismo}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:EkranVm}">
            <prikaz:EkranSenzora />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PodesavanjaVm}">
            <prikaz:EkranPodesavanja />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Header: icon, name, version on the left; where the numbers come from on the right -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0,20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/assets/app.ico" Width="30" Height="30"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,11,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="BRONXSOFT" Foreground="{StaticResource Bled}" FontSize="9"
                                   FontWeight="SemiBold" Margin="1,0,0,-1" />
                        <TextBlock Text="Takt" Foreground="{StaticResource Tekst}" FontSize="19" FontWeight="SemiBold"
                                   FontFamily="{StaticResource PismoNaslov}" Margin="0,-3,0,0" />
                    </StackPanel>
                    <Border Background="{StaticResource Povrsina}" BorderBrush="{StaticResource Linija}"
                            BorderThickness="1" CornerRadius="999" Padding="9,2,9,3" Margin="12,4,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Verzija}" Foreground="{StaticResource Mutan}" FontSize="10.5" />
                    </Border>
                </StackPanel>

                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource Povrsina}"
                        BorderBrush="{StaticResource Linija}" BorderThickness="1" CornerRadius="999" Padding="11,5,13,6">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="Sjaj" Opacity="0.3">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Bled}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VrstaStanja}" Value="pravo">
                                                <Setter Property="Fill" Value="{StaticResource Akcenat}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding VrstaStanja}" Value="pomocnik">
                                                <Setter Property="Fill" Value="{StaticResource Dobro}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding VrstaStanja}" Value="probno">
                                                <Setter Property="Fill" Value="{StaticResource Upozorenje}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding VrstaStanja}" Value="nema">
                                                <Setter Property="Fill" Value="{StaticResource Vruce}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Fill="{Binding Fill, ElementName=Sjaj}" />
                        </Grid>
                        <TextBlock Text="{Binding Stanje}" Foreground="{StaticResource Tekst}" FontSize="11.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- What the user has to know right now -->
        <Border Grid.Row="1" Background="#1D1910" BorderBrush="#3E3218" BorderThickness="0,0,0,1"
                Padding="20,8,20,8"
                Visibility="{Binding UpozorenjeVidljivo, Converter={StaticResource BoolUVidljivost}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" Background="#3A2E14"
                        Margin="0,0,11,0" VerticalAlignment="Center">
                    <TextBlock Text="!" Foreground="{StaticResource Upozorenje}" FontWeight="Bold" FontSize="12"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Upozorenje}" Foreground="#E9CF94"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />

                <Button Grid.Column="2" Style="{StaticResource Dugme}" Content="Uključi potpuni nadzor"
                        Padding="14,5" FontSize="11.5" Margin="16,0,0,-3" VerticalAlignment="Center"
                        ToolTip="Pokreće pomoćnika kao administratora (Windows pita za dozvolu). Prozor ostaje običan korisnik."
                        Visibility="{Binding PomocnikMoguc, Converter={StaticResource BoolUVidljivost}}"
                        Click="NaPomocnika" />
            </Grid>
        </Border>

        <!-- Left column from the header to the footer, tiles above the screen -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12,16,12,12">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource NaslovSekcije}" Text="RAČUNAR"
                               Margin="13,0,0,6" />

                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{StaticResource Linija}" Margin="4,0,4,8" />
                        <Button Style="{StaticResource NavDugme}" Click="NaPodesavanja">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M2,4 H14 M2,8 H14 M2,12 H14 M5,2.5 V5.5 M10.5,6.5 V9.5 M7,10.5 V13.5"
                                      Width="16" Height="16" Stretch="None"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Margin="0,0,11,0" VerticalAlignment="Center" />
                                <TextBlock Text="Podešavanja" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox Style="{StaticResource Spisak}"
                             ItemContainerStyle="{StaticResource NavStavka}"
                             ItemsSource="{Binding Ekrani}"
                             SelectedItem="{Binding Ekran, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{Binding Ikona}" Width="16" Height="16" Stretch="None"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                          StrokeThickness="1.4" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Margin="0,0,11,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Naslov}" FontSize="13"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="{StaticResource Povrsina}" CornerRadius="999"
                                            Padding="7,1,7,2" MinWidth="24" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BrojSenzora}" FontSize="10" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Bled}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- One big number per part of the computer; a click opens that screen -->
                <Border Grid.Row="0" Padding="24,18,14,0"
                        Visibility="{Binding ImaPregled, Converter={StaticResource BoolUVidljivost}}">
                    <ItemsControl ItemsSource="{Binding Pregled}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="{Binding Pregled.Count}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Plocica}" Tag="{Binding Grupa}" Click="NaPlocicu"
                                        Margin="0,0,10,0" ToolTip="{Binding Opis}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <Path Data="{Binding Ikona}" Width="16" Height="16" Stretch="None"
                                                  Stroke="{StaticResource Bled}" StrokeThickness="1.3"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Margin="0,0,7,0" VerticalAlignment="Center">
                                                <Path.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                                </Path.LayoutTransform>
                                            </Path>
                                            <TextBlock Style="{StaticResource MaliNatpis}" Text="{Binding Naslov}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                                                    Margin="0,4,0,0" DataContext="{Binding Senzor}">
                                            <TextBlock Style="{StaticResource BrojNivo}" Text="{Binding BrojPrikaz}"
                                                       FontSize="26" />
                                            <TextBlock Text="{Binding JedinicaPrikaz}" FontSize="11"
                                                       Foreground="{StaticResource Bled}" Margin="5,0,0,5"
                                                       VerticalAlignment="Bottom" />
                                        </StackPanel>

                                        <prikaz:Iskra Grid.Row="1" Grid.Column="1" Height="30" Margin="14,8,0,2"
                                                      VerticalAlignment="Bottom"
                                                      Prsten="{Binding Senzor.Prsten}"
                                                      Mera="{Binding Senzor.Senzor.Jedinica}"
                                                      Tik="{Binding Senzor.Tik}" />

                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Senzor.Ime}"
                                                   Foreground="{StaticResource Bled}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding Prikaz}" Focusable="False" />

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding NemaPrikaza, Converter={StaticResource BoolUVidljivost}}">
                    <Image Source="/assets/app.ico" Width="48" Height="48" Opacity="0.55"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Učitavam senzore…" Foreground="{StaticResource Mutan}" FontSize="13"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>

            </Grid>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}"
                BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="osveženo u" Foreground="{StaticResource Bled}" FontSize="10.5" />
                    <TextBlock Text="{Binding Vreme}" Foreground="{StaticResource Mutan}" FontSize="10.5"
                               Typography.NumeralAlignment="Tabular" Margin="5,0,0,0" />
                    <Ellipse Width="3" Height="3" Fill="{StaticResource Bled}" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding BrojSenzoraTekst}" Foreground="{StaticResource Bled}" FontSize="10.5" />
                    <Ellipse Width="3" Height="3" Fill="{StaticResource Bled}" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Prava}" Foreground="{StaticResource Bled}" FontSize="10.5" />
                </StackPanel>
                <TextBlock Text="Bez interneta · sve ostaje na ovom računaru"
                           Foreground="{StaticResource Bled}" FontSize="10.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
