<Window x:Class="Takt.Prikaz.GlavniProzor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prikaz="clr-namespace:Takt.Prikaz"
        xmlns:vm="clr-namespace:Takt.Vm"
        Title="BronxSoft Takt"
        Height="760" Width="1240" MinHeight="600" MinWidth="980"
        Background="{StaticResource Pozadina}"
        FontFamily="{StaticResource Pismo}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:KanalVm}">
            <prikaz:SoloPanel />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PodesavanjaVm}">
            <prikaz:EkranPodesavanja />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SesijeVm}">
            <prikaz:EkranSesija />
        </DataTemplate>

        <!-- One channel strip of the console -->
        <DataTemplate x:Key="KanalSablon" DataType="{x:Type vm:KanalVm}">
            <Grid Margin="0,0,6,0">
                <!-- Open strip -->
                <Border x:Name="Traka" MinWidth="78" CornerRadius="6" Background="{StaticResource Panel}"
                        BorderBrush="Transparent" BorderThickness="1" Padding="6,10,6,8" Cursor="Hand"
                        MouseLeftButtonUp="NaKanal" ToolTip="{Binding OpisKanala}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource ClipLampica}" Click="NaClip" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding Naslov}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{StaticResource Tekst}" />
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Kratko}" Style="{StaticResource Natpis}" FontSize="10"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,1,4,8" />

                        <!-- Two meters (L / D) or one -->
                        <!-- The meters: two (L / D), one, or one per disk in the disk group. Each sits in its own
                             column with its label under it; the empty strip shows two dark meters as a place. -->
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Meraci}" HorizontalAlignment="Center"
                                      Tag="{Binding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding Tag.SirinaKolone, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                          ToolTip="{Binding Opis}" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <prikaz:VuMerac HorizontalAlignment="Center"
                                                        Width="{Binding Tag.SirinaMeraca, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        Udeo="{Binding Udeo}" Vrh="{Binding Vrh}"
                                                        ToploGranica="{Binding Toplo}" VruceGranica="{Binding Vruce}"
                                                        Visibility="{Binding ImaSkalu, Converter={StaticResource BoolUVidljivost}}" />
                                        <TextBlock Grid.Row="1" Text="{Binding Oznaka}" Style="{StaticResource Natpis}" FontSize="10"
                                                   TextAlignment="Center" Margin="0,5,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="Mesto" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="Collapsed">
                            <prikaz:VuMerac Width="14" Margin="5,0" />
                            <prikaz:VuMerac Width="14" Margin="5,0" />
                        </StackPanel>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0"
                                    DataContext="{Binding Glavni}">
                            <TextBlock Style="{StaticResource BrojNivo}" Text="{Binding BrojPrikaz, FallbackValue=—}" FontSize="16" />
                            <TextBlock Text="{Binding JedinicaPrikaz}" Style="{StaticResource Natpis}" FontSize="10"
                                       Margin="2,0,0,2" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock x:Name="Drugi" Grid.Row="5" HorizontalAlignment="Center" FontSize="11"
                                   Text="{Binding DrugiTekst}" Foreground="{StaticResource Mutan}"
                                   Typography.NumeralAlignment="Tabular" />

                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Style="{StaticResource Taster}" Content="S" Tag="{Binding Solo}" Click="NaSolo"
                                    ToolTip="{prikaz:T 'Solo: ovaj kanal desno'}" Margin="0,0,4,0" />
                            <Button Style="{StaticResource Taster}" Content="M" Tag="{Binding Utisan}" Click="NaUtisaj"
                                    ToolTip="{prikaz:T 'Utišaj: skupi kanal (pamti se)'}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Muted strip: a narrow band with the name on its side -->
                <Border x:Name="Uska" Width="30" CornerRadius="6" Background="{StaticResource Panel}" Padding="0,10,0,8"
                        Visibility="Collapsed" ToolTip="{Binding OpisKanala}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource Taster}" Content="M" Tag="{Binding Utisan}"
                                Click="NaUtisaj" ToolTip="{prikaz:T 'Vrati kanal'}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Naslov}" Style="{StaticResource Natpis}" HorizontalAlignment="Center"
                                   VerticalAlignment="Top">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="-90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </DockPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Solo}" Value="True">
                    <Setter TargetName="Traka" Property="BorderBrush" Value="{StaticResource Akcenat}" />
                    <Setter TargetName="Traka" Property="Background" Value="{StaticResource Povrsina}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Prazan}" Value="True">
                    <Setter TargetName="Traka" Property="Opacity" Value="0.5" />
                    <Setter TargetName="Mesto" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Drugi" Property="Foreground" Value="{StaticResource Bled}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Utisan}" Value="True">
                    <Setter TargetName="Traka" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Uska" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- Header: name and beat on the left, state and the two actions on the right -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/assets/app.ico" Width="20" Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,9,0" />
                    <TextBlock Text="Takt" Foreground="{StaticResource Tekst}" FontSize="15" FontWeight="SemiBold"
                               FontFamily="{StaticResource PismoNaslov}" VerticalAlignment="Center" />
                    <TextBlock Text="BronxSoft" Style="{StaticResource Natpis}" Margin="8,2,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Ritam}" Foreground="{StaticResource Mutan}" FontSize="11"
                               Margin="18,2,0,0" VerticalAlignment="Center"
                               ToolTip="{prikaz:T 'Ritam čitanja senzora; menja se u podešavanjima'}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Bled}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VrstaStanja}" Value="pravo">
                                        <Setter Property="Fill" Value="{StaticResource Upozorenje}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VrstaStanja}" Value="pomocnik">
                                        <Setter Property="Fill" Value="{StaticResource Dobro}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VrstaStanja}" Value="probno">
                                        <Setter Property="Fill" Value="{StaticResource Akcenat}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VrstaStanja}" Value="nema">
                                        <Setter Property="Fill" Value="{StaticResource Vruce}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Stanje}" Foreground="{StaticResource Mutan}" FontSize="12"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource Dugme}" Content="Uključi potpuni nadzor" Margin="12,0,0,0"
                            ToolTip="{prikaz:T 'Pokreće pomoćnika kao administratora (Windows pita za dozvolu). Prozor ostaje običan korisnik.'}"
                            Visibility="{Binding PomocnikMoguc, Converter={StaticResource BoolUVidljivost}}"
                            Click="NaPomocnika" />
                    <Button Style="{StaticResource DugmeTiho}" Margin="12,0,0,0" Content="{prikaz:T 'Sesije'}" Click="NaSesije"
                            ToolTip="{prikaz:T 'Izveštaji o odigranim sesijama: trajanje, FPS, zastoji, temperature'}" />
                    <Button Style="{StaticResource DugmeTamno}" Margin="6,0,0,0" Content="{prikaz:T 'Scene  F1'}" Click="NaScenu"
                            ToolTip="{prikaz:T 'Veliki pult preko celog ekrana, za drugi monitor dok igraš (F1 ili F11, Esc izlazi)'}" />
                    <Button x:Name="DugmePodesavanja" Margin="8,0,0,0" Width="32"
                            Padding="0" ToolTip="{prikaz:T 'Podešavanja'}" Click="NaPodesavanja">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DugmeTiho}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PodesavanjaOtvorena}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Akcenat}" />
                                        <Setter Property="Background" Value="{StaticResource Povrsina}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M2,4 H14 M2,8 H14 M2,12 H14 M5,2.5 V5.5 M10.5,6.5 V9.5 M7,10.5 V13.5"
                              Width="16" Height="16" Stretch="None" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- The console on the left, the solo channel (or the settings) on the right -->
        <Grid Grid.Row="1" Margin="12,12,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MaxWidth="560" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,6,0" PreviewMouseWheel="NaTockicPulta">
                <ItemsControl ItemsSource="{Binding Kanali}" ItemTemplate="{StaticResource KanalSablon}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <ContentControl Grid.Column="1" Content="{Binding Prikaz}" Focusable="False" />

            <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding NemaPrikaza, Converter={StaticResource BoolUVidljivost}}">
                <Image Source="/assets/app.ico" Width="40" Height="40" Opacity="0.5"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Učitavam senzore…" Foreground="{StaticResource Mutan}" FontSize="12"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Grid>

        <!-- Footer: the message of the moment on the left, quietly; facts on the right -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linija}"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding UpozorenjeVidljivo, Converter={StaticResource BoolUVidljivost}}">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource Upozorenje}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Upozorenje}" Foreground="{StaticResource Mutan}" FontSize="11"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Upozorenje}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding Vreme}" Style="{StaticResource Natpis}" Typography.NumeralAlignment="Tabular" />
                    <TextBlock Text="·" Style="{StaticResource Natpis}" Margin="7,0" />
                    <TextBlock Text="{Binding BrojSenzoraTekst}" Style="{StaticResource Natpis}" />
                    <TextBlock Text="·" Style="{StaticResource Natpis}" Margin="7,0" />
                    <TextBlock Text="{Binding Prava}" Style="{StaticResource Natpis}" />
                    <TextBlock Text="·" Style="{StaticResource Natpis}" Margin="7,0" />
                    <TextBlock Text="{Binding Verzija}" Style="{StaticResource Natpis}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The Scene over everything, for the second screen (F11 / Esc) -->
        <prikaz:Scena Grid.RowSpan="3" Visibility="{Binding Scena, Converter={StaticResource BoolUVidljivost}}" />
    </Grid>
</Window>
