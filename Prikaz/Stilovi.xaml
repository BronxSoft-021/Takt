<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:prikaz="clr-namespace:Takt.Prikaz"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- The console: dark equipment, one orange accent. Flat, 4 px controls, 8 px panels. -->
    <Color x:Key="BojaPozadina">#101214</Color>
    <Color x:Key="BojaPanel">#15181B</Color>
    <Color x:Key="BojaPovrsina">#1C2024</Color>
    <Color x:Key="BojaPovrsinaHover">#242A2F</Color>
    <Color x:Key="BojaLinija">#2A3035</Color>
    <Color x:Key="BojaLinijaJaka">#3A4249</Color>
    <Color x:Key="BojaTekst">#EDE9E1</Color>
    <Color x:Key="BojaMutan">#A8A49C</Color>
    <Color x:Key="BojaBled">#6E6B66</Color>
    <Color x:Key="BojaAkcenat">#F0A23B</Color>
    <Color x:Key="BojaAkcenatHover">#F5B25A</Color>
    <Color x:Key="BojaAkcenatPritisak">#D8871F</Color>
    <Color x:Key="BojaNaAkcentu">#1B1206</Color>
    <Color x:Key="BojaUpozorenje">#E8B33A</Color>
    <Color x:Key="BojaVruce">#E5654C</Color>
    <Color x:Key="BojaDobro">#6CC28A</Color>
    <Color x:Key="BojaGrafikon">#121518</Color>
    <Color x:Key="BojaIzabrano">#262B30</Color>

    <SolidColorBrush x:Key="Pozadina" Color="{StaticResource BojaPozadina}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource BojaPanel}" />
    <SolidColorBrush x:Key="Povrsina" Color="{StaticResource BojaPovrsina}" />
    <SolidColorBrush x:Key="PovrsinaHover" Color="{StaticResource BojaPovrsinaHover}" />
    <SolidColorBrush x:Key="Linija" Color="{StaticResource BojaLinija}" />
    <SolidColorBrush x:Key="LinijaJaka" Color="{StaticResource BojaLinijaJaka}" />
    <SolidColorBrush x:Key="Tekst" Color="{StaticResource BojaTekst}" />
    <SolidColorBrush x:Key="Mutan" Color="{StaticResource BojaMutan}" />
    <SolidColorBrush x:Key="Bled" Color="{StaticResource BojaBled}" />
    <SolidColorBrush x:Key="Akcenat" Color="{StaticResource BojaAkcenat}" />
    <SolidColorBrush x:Key="AkcenatHover" Color="{StaticResource BojaAkcenatHover}" />
    <SolidColorBrush x:Key="AkcenatPritisak" Color="{StaticResource BojaAkcenatPritisak}" />
    <SolidColorBrush x:Key="NaAkcentu" Color="{StaticResource BojaNaAkcentu}" />
    <SolidColorBrush x:Key="Upozorenje" Color="{StaticResource BojaUpozorenje}" />
    <SolidColorBrush x:Key="Vruce" Color="{StaticResource BojaVruce}" />
    <SolidColorBrush x:Key="Dobro" Color="{StaticResource BojaDobro}" />
    <SolidColorBrush x:Key="GrafikonPozadina" Color="{StaticResource BojaGrafikon}" />
    <SolidColorBrush x:Key="Izabrano" Color="{StaticResource BojaIzabrano}" />

    <BooleanToVisibilityConverter x:Key="BoolUVidljivost" />
    <prikaz:ObrnutaVidljivost x:Key="BoolUNevidljivost" />

    <FontFamily x:Key="Pismo">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="PismoNaslov">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- ===== Text: four sizes - 11 small print, 12-13 text, 20 titles, 28 the big number ===== -->
    <Style x:Key="NaslovStrane" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PismoNaslov}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="OpisStrane" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Mutan}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Small print, like the labels printed on a device -->
    <Style x:Key="Natpis" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource Bled}" />
    </Style>

    <Style x:Key="NaslovSekcije" TargetType="TextBlock" BasedOn="{StaticResource Natpis}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MaliNatpis" TargetType="TextBlock" BasedOn="{StaticResource Natpis}" />

    <!-- Numbers: display face, tabular figures, so a changing value does not wiggle. -->
    <Style x:Key="Broj" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PismoNaslov}" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- A number that turns amber when warm and red when hot (DataContext is a SenzorVm). -->
    <Style x:Key="BrojNivo" TargetType="TextBlock" BasedOn="{StaticResource Broj}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Nivo}" Value="toplo">
                <Setter Property="Foreground" Value="{StaticResource Upozorenje}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Nivo}" Value="vruce">
                <Setter Property="Foreground" Value="{StaticResource Vruce}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Panels ===== -->
    <Style x:Key="Kartica" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Panel}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ===== Buttons: flat, 4 px ===== -->
    <Style x:Key="Dugme" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Akcenat}" />
        <Setter Property="Foreground" Value="{StaticResource NaAkcentu}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Okvir" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource AkcenatHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource AkcenatPritisak}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Okvir" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DugmeTamno" TargetType="Button" BasedOn="{StaticResource Dugme}">
        <Setter Property="Background" Value="{StaticResource Povrsina}" />
        <Setter Property="BorderBrush" Value="{StaticResource LinijaJaka}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Okvir" Background="{TemplateBinding Background}" CornerRadius="4"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource PovrsinaHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource Panel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No frame until the mouse is on it: icon buttons in the header, "Još 30 senzora…". -->
    <Style x:Key="DugmeTiho" TargetType="Button" BasedOn="{StaticResource DugmeTamno}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Mutan}" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <Style x:Key="Veza" TargetType="Button" BasedOn="{StaticResource DugmeTiho}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- S and M on a channel strip: small square keys, lit when on (Tag = on/off). -->
    <Style x:Key="Taster" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="18" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Mutan}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Okvir" Background="{StaticResource Povrsina}" CornerRadius="3"
                            BorderBrush="{StaticResource LinijaJaka}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource PovrsinaHover}" />
                        </Trigger>
                        <Trigger Property="Tag">
                            <Trigger.Value>
                                <sys:Boolean>True</sys:Boolean>
                            </Trigger.Value>
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource Akcenat}" />
                            <Setter TargetName="Okvir" Property="BorderBrush" Value="{StaticResource Akcenat}" />
                            <Setter Property="Foreground" Value="{StaticResource NaAkcentu}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Table rows ===== -->
    <Style x:Key="RedStavka" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Okvir" Background="Transparent" BorderBrush="{StaticResource Linija}"
                            BorderThickness="0,0,0,1" Padding="8,5">
                        <Grid>
                            <Border x:Name="Traka" Width="2" HorizontalAlignment="Left" Margin="-8,-5,0,-5"
                                    Background="{StaticResource Akcenat}" Visibility="Collapsed" />
                            <ContentPresenter />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource Povrsina}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource Izabrano}" />
                            <Setter TargetName="Traka" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small choices, one click: 1 / 2 / 5 seconds. A row of joined keys. -->
    <Style x:Key="Pilula" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Mutan}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Okvir" Background="{StaticResource Povrsina}" CornerRadius="4" MinWidth="40"
                            BorderBrush="{StaticResource LinijaJaka}" BorderThickness="1" Padding="12,4" Margin="0,0,4,0">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource PovrsinaHover}" />
                            <Setter Property="Foreground" Value="{StaticResource Tekst}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Okvir" Property="Background" Value="{StaticResource Akcenat}" />
                            <Setter TargetName="Okvir" Property="BorderBrush" Value="{StaticResource Akcenat}" />
                            <Setter Property="Foreground" Value="{StaticResource NaAkcentu}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Pilule" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Pilula}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Spisak" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource RedStavka}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Check box ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Kutija" Width="16" Height="16" CornerRadius="3"
                                Background="{StaticResource Povrsina}" BorderBrush="{StaticResource LinijaJaka}"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Kvacica" Data="M 3.5,8 L 6.5,11 L 12.5,4.5"
                                  Stroke="{StaticResource NaAkcentu}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Kutija" Property="Background" Value="{StaticResource Akcenat}" />
                            <Setter TargetName="Kutija" Property="BorderBrush" Value="{StaticResource Akcenat}" />
                            <Setter TargetName="Kvacica" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Kutija" Property="BorderBrush" Value="{StaticResource Akcenat}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tool tip ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource PovrsinaHover}" />
        <Setter Property="Foreground" Value="{StaticResource Tekst}" />
        <Setter Property="BorderBrush" Value="{StaticResource LinijaJaka}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,5" MaxWidth="340">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scroll bars: thin, dark, no arrows, both directions ===== -->
    <ControlTemplate x:Key="KlizacSablon" TargetType="Thumb">
        <Border x:Name="Klizac" Background="#343B41" CornerRadius="3" Margin="2" />
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Klizac" Property="Background" Value="#4A535B" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Template="{StaticResource KlizacSablon}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource KlizacSablon}" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
