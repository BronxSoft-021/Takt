<UserControl x:Class="Takt.Prikaz.EkranSenzora"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prikaz="clr-namespace:Takt.Prikaz"
             Background="{StaticResource Pozadina}">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="2,0,0,16">
            <TextBlock Style="{StaticResource NaslovStrane}" Text="{Binding Naslov}" FontSize="22" />
            <TextBlock Style="{StaticResource OpisStrane}" Text="{Binding Opis}" Margin="0,3,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- With sensors: the list on the left, the chart on the right -->
            <Grid Visibility="{Binding Prazan, Converter={StaticResource BoolUNevidljivost}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="376" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Kartica}">
                    <DockPanel Margin="6,6,6,6">
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource Veza}" Margin="2,4,2,0"
                                Content="{Binding SkriveniTekst}" Click="NaSkrivene"
                                ToolTip="Senzori koje biblioteka navodi, ali na ovom računaru još nisu dali broj - obično traže drajver."
                                Visibility="{Binding ImaSkrivenih, Converter={StaticResource BoolUVidljivost}}" />

                        <ListBox Style="{StaticResource Spisak}"
                                 ItemsSource="{Binding Pogled}"
                                 SelectedItem="{Binding Izabran, Mode=TwoWay}">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource MaliNatpis}"
                                                       Margin="12,12,0,4" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Ime}" Foreground="{StaticResource Tekst}"
                                                       FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Uredjaj}" Foreground="{StaticResource Bled}"
                                                       FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <TextBlock Style="{StaticResource BrojNivo}" Text="{Binding BrojPrikaz}"
                                                       FontSize="16" />
                                            <TextBlock Text="{Binding JedinicaPrikaz}" Foreground="{StaticResource Bled}"
                                                       FontSize="10.5" Margin="4,0,0,2" VerticalAlignment="Bottom"
                                                       MinWidth="22" />
                                        </StackPanel>

                                        <!-- How full: only percent and degrees have a natural "full" -->
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Height="3" CornerRadius="1.5"
                                                Background="#262B30" Margin="0,7,0,0"
                                                Visibility="{Binding ImaUdeo, Converter={StaticResource BoolUVidljivost}}">
                                            <Border HorizontalAlignment="Stretch" CornerRadius="1.5"
                                                    RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding Udeo, FallbackValue=0}" />
                                                </Border.RenderTransform>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Akcenat}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Nivo}" Value="toplo">
                                                                <Setter Property="Background" Value="{StaticResource Upozorenje}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Nivo}" Value="vruce">
                                                                <Setter Property="Background" Value="{StaticResource Vruce}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Kartica}" Margin="16,0,0,0">
                    <Grid Margin="20,18,20,18" DataContext="{Binding Izabran}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Vrsta}" Style="{StaticResource MaliNatpis}" />
                                <TextBlock Text="{Binding Ime}" Foreground="{StaticResource Tekst}" Margin="0,3,0,0"
                                           FontFamily="{StaticResource PismoNaslov}"
                                           FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Uredjaj}" Foreground="{StaticResource Bled}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="14,0,0,0">
                                <TextBlock Text="{Binding BrojPrikaz}" FontSize="38">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BrojNivo}">
                                            <Setter Property="Foreground" Value="{StaticResource Akcenat}" />
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding JedinicaPrikaz}" Foreground="{StaticResource Mutan}"
                                           FontSize="13" Margin="6,0,0,7" VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Grid>

                        <prikaz:Grafikon Grid.Row="1" Margin="0,14,0,14" MinHeight="160"
                                         Prsten="{Binding Prsten}"
                                         Mera="{Binding Senzor.Jedinica}"
                                         Tik="{Binding Tik}"
                                         Perioda="{Binding DataContext.Perioda, RelativeSource={RelativeSource AncestorType=Window}}" />

                        <UniformGrid Grid.Row="2" Rows="1" Columns="4">
                            <Border Style="{StaticResource Brojka}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MaliNatpis}" Text="NAJMANJE" />
                                    <TextBlock Style="{StaticResource Broj}" Text="{Binding Najmanje}"
                                               Foreground="{StaticResource Mutan}" FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Brojka}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MaliNatpis}" Text="PROSEK" />
                                    <TextBlock Style="{StaticResource Broj}" Text="{Binding Prosek}"
                                               Foreground="{StaticResource Mutan}" FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Brojka}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MaliNatpis}" Text="NAJVIŠE" />
                                    <TextBlock Style="{StaticResource Broj}" Text="{Binding Najvise}"
                                               Foreground="{StaticResource Mutan}" FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Brojka}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource MaliNatpis}" Text="SADA" />
                                    <TextBlock Style="{StaticResource BrojNivo}" Text="{Binding Vrednost}"
                                               FontSize="14" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

            </Grid>

            <!-- Without sensors: why, and the one button that would bring them -->
            <Border Style="{StaticResource Kartica}" Padding="30"
                    Visibility="{Binding Prazan, Converter={StaticResource BoolUVidljivost}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Panel}"
                            BorderBrush="{StaticResource Linija}" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="{Binding Ikona}" Width="16" Height="16" Stretch="None"
                              Stroke="{StaticResource Mutan}" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.LayoutTransform>
                                <ScaleTransform ScaleX="1.75" ScaleY="1.75" />
                            </Path.LayoutTransform>
                        </Path>
                    </Border>
                    <TextBlock Text="Ovde još nema podataka" Foreground="{StaticResource Tekst}" Margin="0,16,0,0"
                               FontFamily="{StaticResource PismoNaslov}"
                               FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding PorukaPrazno}" Foreground="{StaticResource Mutan}" FontSize="12.5"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" LineHeight="20" />
                    <Button Style="{StaticResource Dugme}" Content="Uključi potpuni nadzor"
                            HorizontalAlignment="Center" Margin="0,20,0,0" Click="NaPomocnika"
                            Visibility="{Binding DataContext.PomocnikMoguc, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolUVidljivost}}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
