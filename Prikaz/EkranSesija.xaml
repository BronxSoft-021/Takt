<UserControl x:Class="Takt.Prikaz.EkranSesija"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Past game sessions: the list on the left, the report on the right. DataContext is a SesijeVm. -->
    <Border Style="{StaticResource Kartica}" Padding="18,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource NaslovStrane}" Text="Sesije igara" />
                <TextBlock Style="{StaticResource OpisStrane}" Margin="0,3,0,0"
                           Text="Takt sam snima svaku igru duže od minuta (kad usluga meri kadrove) i posle nje pravi izveštaj." />
            </StackPanel>

            <TextBlock Grid.Row="1" Foreground="{StaticResource Mutan}" FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" TextAlignment="Center"
                       Visibility="{Binding Prazno, Converter={StaticResource BoolUVidljivost}}"
                       Text="Još nema nijedne sesije. Pokreni igru: posle deset sekundi Takt počinje da snima, a kad je ugasiš, izveštaj se pojavi ovde." />

            <Grid Grid.Row="1" Visibility="{Binding Prazno, Converter={StaticResource BoolUNevidljivost}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox Style="{StaticResource Spisak}" ItemsSource="{Binding Sesije}"
                         SelectedItem="{Binding Izabrana, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Igra}" FontSize="13" Foreground="{StaticResource Tekst}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Pocetak, StringFormat='{}{0:d. M. yyyy. HH:mm}'}"
                                           Style="{StaticResource Natpis}" />
                                <TextBlock Text="{Binding Kratko}" Foreground="{StaticResource Mutan}" FontSize="11.5"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Margin="24,0,0,0" DataContext="{Binding Izabrana}">
                    <TextBlock Text="{Binding Naslov}" Foreground="{StaticResource Tekst}" FontSize="17"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <ItemsControl ItemsSource="{Binding Redovi}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Linija}" BorderThickness="0,0,0,1" Padding="0,7">
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource Tekst}" FontSize="13"
                                               TextWrapping="Wrap" Typography.NumeralAlignment="Tabular" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
